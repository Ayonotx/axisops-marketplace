# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# AxisOps marketplace runtime data
/data/
*.log
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# E2E artifacts (jars, seeded ids, mock logs)
*.jar
listing*.txt
push-listing.txt
scripts/push-*.json
scripts/push-mock*.log
scripts/arkesel-mock.log

# local dev server logs/pids
dev-server.log*
dev-server.pid

# Android build outputs + signing material (never commit keystores)
android/app/build/
android/*.apk
android/*.apk.idsig
android/*.aab
android/axisops-upload.jks
android/KEYSTORE-SECRET.txt

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
